{
	servers {
		# Tailscale Funnel / cloudflared reach Caddy from the Docker gateway (private range).
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

:8080 {
	handle /health {
		reverse_proxy api:8787
	}

	handle /api/* {
		reverse_proxy api:8787 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Expo web build (static SPA), mounted only by compose.vps.yml. Missing bundles must 404, not fall back to HTML.
	redir /app /app/ 308
	handle_path /app/_expo/* {
		root * /srv/mobile-web/_expo
		file_server
	}
	handle_path /app/* {
		root * /srv/mobile-web
		try_files {path} /index.html
		file_server
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}
}
