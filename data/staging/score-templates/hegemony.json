      "labelVi": "Tiền còn lại",
      "hint": "After loan settlement.",
      "scope": "player",
      "input": "number",
      "formula": {
        "type": "expr",
        "expr": "cat_role==1?min(15,floor(value/10)):(cat_role==2?floor(value/15):(cat_role==4?floor(value/30):0))"
      },
      "countsToTotal": true
    },
    {
      "key": "storage",
      "label": "Stored resources",
      "labelVi": "Tài nguyên lưu kho",
