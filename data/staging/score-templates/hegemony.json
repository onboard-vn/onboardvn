      "scope": "player",
      "input": "count",
      "formula": {
        "type": "expr",
        "expr": "cat_role==4?0:(value==0?0:(cat_role==2?(value==1?1:(value==2?3:(value==3?6:(value==4?10:15)))):(value==1?1:(value==2?4:(value==3?8:(value==4?12:18))))))"
