      "input": "counts",
      "formula": {
        "type": "expr",
        "expr": "cat_role==3?-5*loans:-unpaidUnits"
      },
      "countsToTotal": true,
      "inputs": [
        "loans",
        "unpaidUnits"
      ]
    },
