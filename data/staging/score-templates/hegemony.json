      "input": "counts",
      "formula": {
        "type": "expr",
        "expr": "cat_role==1?0:floor(food/2)+floor(luxury/3)+floor(health/3)+floor(education/3)+(cat_role==4?floor(media/3):0)"
      },
      "countsToTotal": true,
      "inputs": [
        "food",
        "luxury",
        "health",
        "education",
        "media"
      ]
    },
    {
      "key": "debt",
      "label": "Loan penalties",
