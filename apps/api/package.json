{
  "name": "@onboard/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:seed-locations": "tsx --env-file-if-exists=.env src/db/seed-locations.ts",
    "auth:set-password": "tsx --env-file-if-exists=.env src/db/set-password.ts",
    "db:import-club-games": "tsx --env-file-if-exists=.env src/db/import-club-games.ts",
    "sync:club": "tsx --env-file-if-exists=.env src/integrations/external-club/sync-cli.ts",
    "db:studio": "drizzle-kit studio",
    "dataset:export": "tsx --env-file-if-exists=.env src/dataset/export-cli.ts",
    "dataset:import": "tsx --env-file-if-exists=.env src/dataset/import-cli.ts",
    "dataset:validate": "tsx src/dataset/validate-cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@onboard/shared": "workspace:*",
    "better-auth": "^1.7.5",
    "csv-parse": "7.0.2",
    "csv-stringify": "6.8.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "hono-rate-limiter": "^0.5.4",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@onboard/config": "workspace:*",
    "@readme/openapi-parser": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vitest": "^5.0.1"
  }
}
